# Leave VITE_API_BASE_URL empty in dev to use the Vite proxy (/api and /ws → gateway :8080).
# Production (Vercel): set to your HTTPS gateway URL — required for cross-origin cookie auth.
# VITE_API_BASE_URL=https://api.yourdomain.com

VITE_CUSTOMER_APP_URL=http://localhost:5173

# WalletConnect — required for Settings → Crypto wallet
VITE_WALLETCONNECT_PROJECT_ID=
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org
VITE_ETHEREUM_RPC_URL=https://ethereum.publicnode.com
VITE_BSC_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
VITE_ETHEREUM_USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Hidden load test dashboard at /load-test (super_admin only). Set false for client handoff.
VITE_ENABLE_LOAD_TEST=false
